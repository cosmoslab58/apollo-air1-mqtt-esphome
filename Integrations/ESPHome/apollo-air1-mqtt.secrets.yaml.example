# Copy this file to secrets.yaml (gitignored) and fill in real values before compiling.
#
#   cp apollo-air1-mqtt.secrets.yaml.example secrets.yaml
#
# Everything site-specific lives here. The only things you should need to edit in
# apollo-air1-mqtt.yaml itself are the `substitutions:` at the top (device name,
# MQTT topic root, and broker port).

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Password for the ESPHome (push) OTA platform, used by `just install` and
# `esphome run`. The MQTT pull-OTA path does not use it.
ota_password: "choose-a-strong-password"

# --- MQTT broker -----------------------------------------------------------
# Host only. The port is the `mqtt_port` substitution in apollo-air1-mqtt.yaml
# (8883 for TLS, 1883 for plaintext).
mqtt_broker: "mqtt.example.com"
mqtt_username: "YOUR_MQTT_USERNAME"
mqtt_password: "YOUR_MQTT_PASSWORD"

# OPTIONAL: root of this device's MQTT topic tree, overriding the default in
# apollo-air1-mqtt.yaml (esphome/apollo-air-1). Useful when you have an existing
# topic convention and would rather not carry a local edit to a tracked file.
# The justfile passes it to ESPHome as `-s mqtt_topic <value>`, and
# scripts/air1-ota.py reads it from here too, so both stay in sync.
# Leave it out entirely to just use the value in the YAML.
#mqtt_topic: "site/area/air1"

# CA certificate that signed your broker's TLS certificate, in PEM form.
# ESPHome's mqtt component requires an explicit CA -- it cannot use esp-idf's
# bundled root store the way http_request can.
#
#   * Broker with a Let's Encrypt certificate -> the ISRG Root X1 block below
#     is already correct; leave it as is. (Valid until 2035.)
#   * Broker with a private/self-signed CA -> replace the block with your CA.
#   * Plaintext broker (no TLS) -> delete this key, comment out the
#     `certificate_authority:` line in apollo-air1-mqtt.yaml, and set the
#     `mqtt_port` substitution to 1883.
#
# To see what your broker actually presents, and which root it chains to:
#   openssl s_client -connect YOUR_BROKER:8883 -showcerts </dev/null
mqtt_ca_cert: |
  -----BEGIN CERTIFICATE-----
  MIIFazCCA1OgAwIBAgIRAIIQz7DSQONZRGPgu2OCiwAwDQYJKoZIhvcNAQELBQAw
