# Copy this file to secrets.yaml (gitignored) and fill in real values before compiling.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Password for the ESPHome OTA platform (used for over-the-air firmware updates).
ota_password: "choose-a-strong-password"

# mosquitto broker on bodhi (iot Docker Compose stack)
mqtt_broker: "192.168.4.113"
mqtt_username: "YOUR_MQTT_USERNAME"
mqtt_password: "YOUR_MQTT_PASSWORD"
