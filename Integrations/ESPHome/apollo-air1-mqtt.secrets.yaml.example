# --- Pull-OTA firmware hosting ---------------------------------------------
# Used by scripts/air1-ota.py (`just ota`), not by the firmware build.
#
# ota_publish_dir : local directory the firmware image is copied into. Must be
#                   served by a web server the DEVICE can reach.
# ota_base_url    : the URL that same directory is reachable at, from the device.
#
# The device's downloader follows redirects and validates HTTPS against esp-idf's
# bundled root CAs, so a normal Let's Encrypt site works with no extra setup.
# Any static host will do -- nginx, Caddy, Apache, `python3 -m http.server`, an
# S3 bucket. air1-ota.py checks the URL returns a direct 200 before triggering.
#
# Both can also be supplied as AIR1_PUBLISH_DIR / AIR1_BASE_URL env vars, or
# --publish-dir / --base-url flags, which take precedence over these.
ota_publish_dir: "~/public_html/apollo-air1"
ota_base_url: "https://example.com/apollo-air1"
